# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# Database and Redis
# Required in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ontheloop
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
# Required in production. Use a random 32+ character value.
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRES_IN=7d

# CTA APIs
# Required in production.
CTA_TRAIN_API_KEY=
CTA_BUS_API_KEY=

# Google Gemini
GOOGLE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Email
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_FROM=
EMAIL_FROM_NAME=

# App behavior
CACHE_TTL=60
SCHEDULE_TIMEZONE=America/Chicago
RUN_WORKER_IN_PROCESS=true
