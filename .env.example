# --- Core (required in prod) ---
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://ctauser:ctapassword@localhost:5432/ctatrack
JWT_SECRET=            # REQUIRED in prod, 32+ chars. App refuses to boot without it (#1)
JWT_EXPIRES_IN=7d

# --- Redis (required in prod; REDIS_URL preferred) ---
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- CTA (required) ---
CTA_TRAIN_API_KEY=
CTA_BUS_API_KEY=

# --- Google Gemini (required for the assistant) ---
GEMINI_API_KEY=        # or GOOGLE_GEMINI_API_KEY

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=   # REQUIRED in prod when the bot is enabled (#14)

# --- Email (optional; both must be set to enable) ---
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_FROM=
# EMAIL_FROM_NAME=

# --- Misc ---
CACHE_TTL=60
SCHEDULE_TIMEZONE=America/Chicago
SENTRY_DSN=
TZ=America/Chicago       # container timezone — see #11

# --- Scaling ---
# Prisma connection pool size per process (default 10). On a split deploy, give
# the web service a modest value and the worker its own.
DB_CONNECTION_LIMIT=10
# true = run the BullMQ worker inside the web process (fine to start).
# Set false on the web service AND run a separate worker service (npm run start:worker)
# so a notification burst can't starve web requests. Scheduling is multi-instance-safe.
RUN_WORKER_IN_PROCESS=true
# Health port for the standalone worker process (only used when split).
WORKER_HEALTH_PORT=3001
